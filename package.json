{
  "name": "flint-universal-sync",
  "version": "1.0.0",
  "description": "Universal cross-device note sync extension for Flint supporting Supabase, Turso, Cloudflare D1, and Custom REST databases.",
  "main": "dist/main.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "flint-extension",
    "flint-plugin",
    "sync",
    "supabase",
    "turso",
    "d1"
  ],
  "author": "Yuliet Li <yuliet@flintnotes.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yvliet/flint-universal-sync.git"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "flint": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  }
}
