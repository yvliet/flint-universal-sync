{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "typeRoots": ["../Flint/node_modules/@types"],
    "paths": {
      "flint": ["../Flint/src/sdk/index.ts"],
      "@flint/sdk": ["../Flint/src/sdk/index.ts"],
      "@/*": ["../Flint/src/*"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"]
    },
    "outDir": "./dist"
  },
  "include": [
    "src/**/*"
  ]
}
